#
# IONOS_MCP_PATH — absolute path to your local ionos-mcp build (see mcp.json ionos args)

# GEMINI_API_KEY=
IONOS_API_KEY=
IONOS_MCP_PATH=C:/Users/angel/tools/ionos-mcp/build/index.js
