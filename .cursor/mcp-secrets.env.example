# Copy to .cursor/mcp-secrets.env (gitignored), or run: npm run mcp:setup
#
# Google AI Studio: one key works for both names below.
#   GEMINI_API_KEY       — aistudio-mcp-server (local Cursor MCP)
#   GOOGLE_AI_API_KEY    — Holzen Supabase edge (llm-gateway.ts); optional here for aliasing
#
# IONOS_MCP_PATH — absolute path to your local ionos-mcp build (see mcp.json ionos args)

GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
IONOS_API_KEY=
IONOS_MCP_PATH=C:/Users/angel/tools/ionos-mcp/build/index.js
