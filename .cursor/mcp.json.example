{
  "mcpServers": {
    "supabase-staging": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=ksplyxxdvandkwzundql&read_only=true"
    },
    "supabase-prod": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=geqkxsnyqvhtascjghuu&read_only=true"
    },
    "aistudio": {
      "command": "node",
      "args": ["scripts/run-mcp-with-env.mjs", "--", "npx", "-y", "aistudio-mcp-server"],
      "env": {
        "GEMINI_MODEL": "gemini-2.5-flash",
        "GEMINI_TIMEOUT": "600000",
        "GEMINI_MAX_OUTPUT_TOKENS": "16384",
        "GEMINI_MAX_FILES": "10",
        "GEMINI_MAX_TOTAL_FILE_SIZE": "50",
        "GEMINI_TEMPERATURE": "0.2"
      }
    },
    "ionos": {
      "command": "node",
      "args": [
        "scripts/run-mcp-with-env.mjs",
        "--",
        "node",
        "C:/path/to/ionos-mcp/build/index.js"
      ]
    }
  }
}
