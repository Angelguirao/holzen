# Database connection strings for dump/restore scripts (never commit real passwords).
#
# Copy to .env.db.local (gitignored), then:
#   npm run db:migrate-prod
#   npm run db:pull:staging
#   npm run db:pull:prod
#
# Get URIs: Supabase Dashboard → Project Settings → Database → Connection string → URI
# Use the **session pooler** on port **5432** (not transaction pooler 6543).
#
# Project refs (2026-05):
#   Legacy Lovable prod: edgbwdecaoottowliimu
#   holzen-staging:      ksplyxxdvandkwzundql
#   holzen-prod:         geqkxsnyqvhtascjghuu

# One-time cutover (migrate-prod-data.sh)
OLD_DATABASE_URL="postgresql://postgres.edgbwdecaoottowliimu:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
NEW_DATABASE_URL="postgresql://postgres.geqkxsnyqvhtascjghuu:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Remote pulls (db-pull-remote.sh)
STAGING_DATABASE_URL="postgresql://postgres.ksplyxxdvandkwzundql:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
PROD_DATABASE_URL="postgresql://postgres.geqkxsnyqvhtascjghuu:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

