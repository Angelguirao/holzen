# Platform exit (2026-05): see [platform-exit-runbook.md](platform-exit-runbook.md) and
# [decisions/2026-05-23-platform-exit-lovable.md](../decisions/2026-05-23-platform-exit-lovable.md).
# Lovable Cloud is being retired — use owned Supabase + GitHub Actions + external frontend host.
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Lovable Cloud: previews/deploys get VITE_SUPABASE_* from Lovable — you do not
# edit .env there. This file matters when you run Vite locally (npm run dev, etc.).
#
# Two backends (optional): keep hosted vs local Supabase in separate files —
#   [.env.hosted.example](.env.hosted.example)  →  npm run dev:hosted
#   [.env.localstack.example](.env.localstack.example)  →  npm run dev:local
#   [.env.staging.example](.env.staging.example)  →  npm run dev:staging (owned staging)
# Copy an example to .env.<mode>.local so secrets stay gitignored (.env.*.local).

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Optional. Canonical public site origin for SEO canonical/OG URLs (default https://holzen.app).
# VITE_SITE_ORIGIN="https://holzen.app"

# Optional. Comma-separated auth user UUIDs for /admin (Lovable: Cloud → Users).
# Admin may also be determined via DB (e.g. is_admin) depending on setup.
# Example: VITE_ADMIN_USER_IDS="a1b2c3d4-e5f6-7890-abcd-ef1234567890"
VITE_ADMIN_USER_IDS=""

# Full `[holzen:*]` flow logs in production-mode Vite (e.g. preview / dev:hosted). Optional.
# VITE_HOLZEN_DEBUG=1

# --- Observability (optional, all no-op without values) ---
# See docs/ops/observability-setup.md for provisioning (Sentry, PostHog, BetterStack, Slack).
#
# Sentry (frontend). DSN is safe to ship in the client bundle. Empty = Sentry is disabled.
# VITE_SENTRY_DSN="https://<public>@<org>.ingest.sentry.io/<project>"
#
# PostHog (frontend). Project API key is safe to ship. Defaults to US cloud.
# VITE_POSTHOG_KEY="phc_..."
# VITE_POSTHOG_HOST="https://us.i.posthog.com"
#
# Optional: force pause stepper macro step 5 label to "Shift" (matches flag pause.step5_breath_label_shift).
# VITE_PAUSE_STEP5_BREATH_LABEL_SHIFT=1
#
# App version — injected as `__APP_VERSION__` at build time. Use Git SHA (7-char) in CI.
# Must match `SENTRY_RELEASE` in edge secrets for cross-surface correlation.
# VITE_APP_VERSION="dev"
#
# Build-only (CI) — source-map upload via @sentry/vite-plugin. Plugin no-ops if any is missing.
# Not read at runtime and must never be exposed to the client bundle.
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# --- Edge function observability secrets (Supabase Dashboard → Edge secrets) ---
# Documented here for discoverability; set per project (staging + prod).
#
# SENTRY_DSN_EDGES     = Sentry DSN for Deno edge functions (same project as frontend is fine)
# SENTRY_RELEASE       = Git SHA (match VITE_APP_VERSION)
# SENTRY_ENVIRONMENT   = production | preview
# LOG_DRAIN_URL        = BetterStack HTTP ingest URL
# LOG_DRAIN_TOKEN      = BetterStack source token
# SLACK_WEBHOOK_URL    = #holzen-alerts incoming webhook URL

# GOOGLE_AI_API_KEY or GEMINI_API_KEY — direct Gemini (primary; see _shared/llm-gateway.ts)
# OPENROUTER_API_KEY — optional failover when Google returns 429/5xx
# OPENROUTER_HTTP_REFERER — optional OpenRouter attribution header
# OPENROUTER_APP_TITLE — optional OpenRouter attribution (default Holzen)
# LOVABLE_API_KEY — legacy Lovable AI gateway (Tier B edges only; not in active LLM fallback chain)
# RESEND_API_KEY — transactional email (preferred over LOVABLE_API_KEY)
# RESEND_WEBHOOK_SECRET — Resend bounce/complaint webhook signing secret (handle-email-suppression)
# SEND_EMAIL_HOOK_SECRET — Supabase Auth Send Email Hook secret (auth-email-hook)
# EMAIL_PREVIEW_SECRET — optional ops bearer for preview-transactional-email / auth preview
# PERPLEXITY_API_KEY — companion generators, fetch-source-feeds
# VITE_* in repo files only affect local/CI Vite builds, not Edge.
#
# Local: create supabase/.env (gitignored) with PERPLEXITY_API_KEY=pplx-...
# Hosted: Supabase Dashboard → Edge Functions → Secrets, or: supabase secrets set ...
#
# Optional testing — Edge Functions (Supabase secrets / supabase/.env for local serve):
# DISABLE_COMPANION_FALLBACKS=1 → generators, holzen-reflect, suggest-grounding skip library/cache/curated
# and hardcoded fallbacks when live AI fails (do not use in production unless intentional).
#
# fetch-source-feeds (optional) — raise for launch backfills; then unset or lower for steady cron.
# FETCH_FEEDS_MAX_SOURCES=15
# FETCH_FEEDS_MAX_ARTICLES_PER_SOURCE=8
# FETCH_FEEDS_ARTICLE_DELAY_MS=500
# FETCH_FEEDS_LOG_ORIGINAL_INFER=false
#
# Phase toggles — control companion generation resolution order (library → cache → live).
# All enabled by default. Set to 0/false/no to disable a phase.
# COMPANION_PHASE_CATALOG=1   → companion_catalog lookups (essays, papers, events) before cache/live
# COMPANION_PHASE_CACHE=1     → companion_cache lookups (previously generated content)
# COMPANION_PHASE_LIVE=1      → live AI generation (Perplexity + structuring)
#
# Optional testing — Vite (this file or .env.hosted / .env.localstack): pairs with the above so the
# app does not use client-side fallbacks (Ground page, guided journal static prompts):
# VITE_DISABLE_COMPANION_FALLBACKS=1
