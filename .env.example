# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Lovable Cloud: previews/deploys get VITE_SUPABASE_* from Lovable — you do not
# edit .env there. This file matters when you run Vite locally (npm run dev, etc.).
#
# Two backends (optional): keep hosted vs local Supabase in separate files —
#   [.env.hosted.example](.env.hosted.example)  →  npm run dev:hosted
#   [.env.localstack.example](.env.localstack.example)  →  npm run dev:local
# Copy an example to .env.<mode>.local so secrets stay gitignored (.env.*.local).

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Optional. Comma-separated auth user UUIDs for /admin (Lovable: Cloud → Users).
# Admin may also be determined via DB (e.g. is_admin) depending on setup.
# Example: VITE_ADMIN_USER_IDS="a1b2c3d4-e5f6-7890-abcd-ef1234567890"
VITE_ADMIN_USER_IDS=""

# --- Supabase Edge Functions only (not Vite) ---
# Generators (signal / grounding / history), suggest-grounding, pregenerate-companions, fetch-source-feeds
# use PERPLEXITY_API_KEY. Do not put API keys in VITE_*.
#
# Local: create supabase/.env (gitignored) with PERPLEXITY_API_KEY=pplx-...
# Hosted: Supabase Dashboard → Edge Functions → Secrets, or: supabase secrets set PERPLEXITY_API_KEY=...
#
# Optional testing: set DISABLE_COMPANION_FALLBACKS=1 so companion generators and holzen-reflect return
# errors/empty instead of library → cache → curated pools when live AI fails (never enable in production
# unless you accept blank companions when models are down).
