# holzen-prod — production Supabase for local prod-like sessions.
#
# Copy to .env.hosted.local (recommended) or .env.hosted, then:
#   npm run dev:hosted
#
# Canonical org projects (2026-05):
#   holzen-prod:    geqkxsnyqvhtascjghuu
#   holzen-staging: ksplyxxdvandkwzundql  → use .env.staging.example for staging
#
# Vite loads: .env → .env.local → .env.hosted → .env.hosted.local

VITE_SUPABASE_PROJECT_ID="geqkxsnyqvhtascjghuu"
VITE_SUPABASE_URL="https://geqkxsnyqvhtascjghuu.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-prod-publishable-key"

# Full client flow visibility: `[holzen:*]` tags + React Query cache logging (same as local `npm run dev`).
# Omit or leave unset for quieter hosted sessions; never ship `1` to real users unless intentional.
# VITE_HOLZEN_DEBUG=1

# Comma-separated Supabase user UUIDs for /admin (optional)
VITE_ADMIN_USER_IDS=""
