# Hosted Supabase (e.g. Lovable / team project). Not used until you opt in.
#
# Copy to .env.hosted.local (recommended) or .env.hosted, then:
#   npm run dev:hosted
#
# Vite loads: .env → .env.local → .env.hosted → .env.hosted.local

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Full client flow visibility: `[holzen:*]` tags + React Query cache logging (same as local `npm run dev`).
# Omit or leave unset for quieter hosted sessions; never ship `1` to real users unless intentional.
# VITE_HOLZEN_DEBUG=1

# Comma-separated Supabase user UUIDs for /admin (optional)
VITE_ADMIN_USER_IDS=""
