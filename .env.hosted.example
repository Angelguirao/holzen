# Hosted Supabase (e.g. Lovable / team project). Not used until you opt in.
#
# Copy to .env.hosted.local (recommended) or .env.hosted, then:
#   npm run dev:hosted
#
# Vite loads: .env → .env.local → .env.hosted → .env.hosted.local

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Comma-separated Supabase user UUIDs for /admin (optional)
VITE_ADMIN_USER_IDS=""
