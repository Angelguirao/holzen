# Local Docker Supabase only — does not use hosted/Lovable keys.
#
# 1. npm run supabase:start
# 2. npm run supabase:status  → copy the anon key
# 3. Copy this file to .env.localstack.local (recommended) or .env.localstack
# 4. npm run dev:local
#
# Vite loads: .env → .env.local → .env.localstack → .env.localstack.local
#
# For this mode, vite.config.ts does NOT fall back to any hosted URL/key.

VITE_SUPABASE_PROJECT_ID="local"
VITE_SUPABASE_URL="http://127.0.0.1:55421"
VITE_SUPABASE_PUBLISHABLE_KEY="paste-anon-key-from-supabase-status"

VITE_ADMIN_USER_IDS=""
