# Owned staging Supabase — not Lovable Cloud.
#
# Copy to .env.staging.local (recommended) or .env.staging, then:
#   npm run dev:staging
#
# Vite loads: .env → .env.local → .env.staging → .env.staging.local

VITE_SUPABASE_PROJECT_ID="your-staging-project-ref"
VITE_SUPABASE_URL="https://your-staging-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-staging-anon-key"

# Optional — full client flow logs during staging QA
# VITE_HOLZEN_DEBUG=1

VITE_ADMIN_USER_IDS=""

# Optional — for scripts/CI (not read by Vite)
# SUPABASE_STAGING_PROJECT_REF="your-staging-project-ref"
