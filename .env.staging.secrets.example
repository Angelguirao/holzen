# Staging edge secrets — gitignored copy: .env.staging.secrets
# Apply: npm run staging:secrets-set
# Never commit real values.

# --- Email (auth + transactional) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SEND_EMAIL_HOOK_SECRET=
# Must match Supabase Auth → Hooks → Send Email hook secret in Dashboard

# Staging identity (omit on prod — see docs/ops/resend-environment-setup.md)
EMAIL_BRAND_NAME=Holzen Staging
EMAIL_FROM_DOMAIN=resend.dev
EMAIL_FROM_LOCAL=onboarding
EMAIL_NOTIFY_LOCAL=onboarding
EMAIL_SENDER_DOMAIN=resend.dev
EMAIL_SUBJECT_PREFIX=[STAGING]
EMAIL_APP_URL=http://localhost:8080

# --- Stripe test mode ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_FLEX_PACK_S=
STRIPE_PRICE_ID_FLEX_PACK_M=

# --- AI (edge LLM: OpenRouter only — docs/ops/llm-openrouter.md) ---
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
# PERPLEXITY_API_KEY=

# --- Cron (optional if already set via bootstrap) ---
# CRON_SECRET=

# --- Observability (staging) ---
SENTRY_DSN_EDGES=https://058e67096a0444d05214743e2d0d6ee6@o4511246392688640.ingest.de.sentry.io/4511247675621456
SENTRY_ENVIRONMENT=staging
# SENTRY_RELEASE= set at deploy via npm run stamp:release
LOG_DRAIN_URL=
LOG_DRAIN_TOKEN=
SLACK_WEBHOOK_URL=

