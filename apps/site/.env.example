# Astro loads env from repo root (vite envDir in astro.config.mjs).
# Required in Vercel/CI for waitlist + landing view counter on /welcome.
#
# PUBLIC_* is preferred for Astro; VITE_* from root .env also works.
# PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...
#
# Or reuse from root .env.production:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
