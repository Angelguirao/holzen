---
/** Decorative product preview — not interactive. */
---

<div class="pause-preview" aria-hidden="true">
  <div class="pause-preview-frame">
    <div class="pause-preview-top">
      <span class="pause-preview-brand">Holzen</span>
      <span class="pause-preview-live">
        <span class="pause-preview-live-dot"></span>
        Live
      </span>
    </div>

    <div class="pause-preview-alert">
      <span class="pause-preview-alert-label">Volatility alert</span>
      <span class="pause-preview-alert-value">BTC · −6.2% · 24h</span>
    </div>

    <div class="pause-preview-ritual">
      <div class="pause-preview-ring">
        <div class="pause-preview-ring-pulse"></div>
        <span class="pause-preview-ring-label">Breathe</span>
      </div>
      <p class="pause-preview-caption">Slow down before you decide</p>
    </div>

    <ol class="pause-preview-steps">
      <li class="pause-preview-step pause-preview-step--done">Feel</li>
      <li class="pause-preview-step pause-preview-step--active">Breathe</li>
      <li class="pause-preview-step">Reflect</li>
      <li class="pause-preview-step">Decide</li>
    </ol>
  </div>
</div>
