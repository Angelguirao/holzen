---
import { landingCopy } from '../lib/landing-content';

const { trustSignals } = landingCopy;
---

<ul class="trust-row" aria-label="Trust signals">
  {
    trustSignals.map((signal) => (
      <li class="trust-pill">
        <span class="trust-pill-dot" aria-hidden="true"></span>
        {signal}
      </li>
    ))
  }
</ul>
