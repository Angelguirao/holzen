---

import { waitlistConfigured } from '../lib/waitlist';



interface Props {

  source?: string;

  ref?: string | null;

  compact?: boolean;

  formId?: string;

  ctaLabel?: string;

}



const {

  source = 'welcome',

  ref = null,

  compact = false,

  formId = 'waitlist-email',

  ctaLabel = 'Get early access',

} = Astro.props;



const configured = waitlistConfigured();

---



{!configured ? (

  <p class="waitlist-unconfigured" role="status">

    Waitlist signup is temporarily unavailable. Email{' '}

    <a href="mailto:hello@holzen.app">hello@holzen.app</a> to request access.

  </p>

) : (

  <form

    class:list={['waitlist-form', compact && 'waitlist-form--compact']}

    data-waitlist-form

    data-waitlist-source={source}

    data-waitlist-ref={ref ?? ''}

    data-waitlist-cta={ctaLabel}

  >

    <label class="waitlist-label" for={formId}>Email</label>

    <div class="waitlist-row">

      <input

        id={formId}

        class="waitlist-input"

        type="email"

        name="email"

        autocomplete="email"

        inputmode="email"

        placeholder="you@example.com"

        required

      />

      <button class="cta waitlist-submit" type="submit">{ctaLabel}</button>

    </div>

    <p class="waitlist-hint muted">One email when your spot opens. Unsubscribe anytime.</p>

    <p class="waitlist-status" data-waitlist-status hidden role="status" aria-live="polite"></p>

  </form>

)}



<script>

  import { pingLandingView, submitWaitlistEmail } from '../lib/waitlist';



  void pingLandingView('/welcome');



  const forms = document.querySelectorAll('[data-waitlist-form]');

  forms.forEach((form) => {

    if (!(form instanceof HTMLFormElement)) return;

    const statusEl = form.querySelector('[data-waitlist-status]');

    if (!(statusEl instanceof HTMLElement)) return;



    const source = form.dataset.waitlistSource ?? 'welcome';

    const ref = form.dataset.waitlistRef?.trim() || null;

    const ctaLabel = form.dataset.waitlistCta ?? 'Get early access';



    form.addEventListener('submit', (event) => {

      event.preventDefault();

      const input = form.querySelector('input[name="email"]');

      if (!(input instanceof HTMLInputElement)) return;



      const email = input.value.trim();

      const submit = form.querySelector('button[type="submit"]');

      if (submit instanceof HTMLButtonElement) {

        submit.disabled = true;

        submit.textContent = 'Saving…';

      }

      statusEl.hidden = true;

      statusEl.dataset.state = '';



      void submitWaitlistEmail(email, { source, ref }).then((result) => {

        if (submit instanceof HTMLButtonElement) {

          submit.disabled = false;

          submit.textContent = ctaLabel;

        }

        statusEl.hidden = false;

        if (result.ok) {

          statusEl.textContent = "You're on the list. We'll email when it's your turn.";

          statusEl.dataset.state = 'ok';

          form.reset();

          form.classList.add('waitlist-form--success');

        } else {

          statusEl.textContent = result.error;

          statusEl.dataset.state = 'error';

        }

      });

    });

  });

</script>


