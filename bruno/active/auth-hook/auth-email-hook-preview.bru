meta {
  name: auth-email-hook preview
  type: http
  seq: 1
}

post {
  url: {{VITE_SUPABASE_URL}}/functions/v1/auth-email-hook/preview
  body: json
  auth: none
}

headers {
  x-cid: bruno-{{$timestamp}}-review
  Authorization: Bearer {{EMAIL_PREVIEW_SECRET}}
  Content-Type: application/json
}

body:json {
  {
    "type": "signup"
  }
}
