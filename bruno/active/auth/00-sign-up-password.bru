meta {
  name: 00 sign-up (password)
  type: http
  seq: 0
}

post {
  url: {{VITE_SUPABASE_URL}}/auth/v1/signup
  body: json
  auth: none
}

headers {
  x-cid: bruno-{{$timestamp}}-review
  Authorization: Bearer {{VITE_SUPABASE_PUBLISHABLE_KEY}}
  apikey: {{VITE_SUPABASE_PUBLISHABLE_KEY}}
  Content-Type: application/json
}

body:json {
  {
    "email": "{{AUTH_EMAIL}}",
    "password": "{{AUTH_PASSWORD}}"
  }
}

script:post-response {
  const data = res.body;
  if (res.status === 200 && data && typeof data.access_token === "string") {
    bru.setEnvVar("SUPABASE_ACCESS_TOKEN", data.access_token);
    if (data.user && data.user.id) bru.setEnvVar("AUTH_USER_ID", data.user.id);
    console.log("Signed up; SUPABASE_ACCESS_TOKEN set. Skip sign-in unless token expired.");
  } else if (res.status === 200 && data && data.user && !data.access_token) {
    console.warn("User created but no session (email confirmation). Confirm email or disable confirm for local dev, then run 01 sign-in.");
  } else {
    const dup = data && (data.msg || data.error_description || data.message || "").toString().toLowerCase().includes("registered");
    if (res.status >= 400 || dup) {
      console.warn("Sign-up did not return a session (user may already exist). Run 01 sign-in with the same AUTH_EMAIL / AUTH_PASSWORD.");
    } else {
      console.warn("Sign-up unexpected response:", res.status, data);
    }
  }
}
