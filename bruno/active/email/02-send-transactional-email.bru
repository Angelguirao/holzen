meta {
  name: 02 send-transactional-email
  type: http
  seq: 2
}

post {
  url: {{VITE_SUPABASE_URL}}/functions/v1/send-transactional-email
  body: json
  auth: none
}

headers {
  x-cid: bruno-{{$timestamp}}-review
  Authorization: Bearer {{SUPABASE_ACCESS_TOKEN}}
  apikey: {{VITE_SUPABASE_PUBLISHABLE_KEY}}
  Content-Type: application/json
}

body:json {
  {
    "templateName": "welcome",
    "recipientEmail": "{{AUTH_EMAIL}}",
    "idempotencyKey": "bruno-welcome-{{$timestamp}}",
    "templateData": {
      "firstName": "Satoshi"
    }
  }
}
