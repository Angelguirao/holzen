meta {
  name: 01 sign-in (password)
  type: http
  seq: 1
}

post {
  url: {{VITE_SUPABASE_URL}}/auth/v1/token?grant_type=password
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{VITE_SUPABASE_PUBLISHABLE_KEY}}
  apikey: {{VITE_SUPABASE_PUBLISHABLE_KEY}}
  Content-Type: application/json
}

body:json {
  {
    "email": "{{AUTH_EMAIL}}",
    "password": "{{AUTH_PASSWORD}}"
  }
}

script:post-response {
  const data = res.body;
  if (res.status === 200 && data && typeof data.access_token === "string") {
    bru.setEnvVar("SUPABASE_ACCESS_TOKEN", data.access_token);
    console.log("SUPABASE_ACCESS_TOKEN set (session memory; run other requests in this Bruno session).");
  } else {
    console.warn("Auth failed or no access_token:", res.status, data);
  }
}
