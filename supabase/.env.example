# Local Edge Function secrets — copy to `supabase/.env` or `supabase/.env.local`
# and use with `npm run supabase:functions:serve`.
#
# The local Supabase CLI provides platform defaults like:
# - SUPABASE_URL
# - SUPABASE_ANON_KEY
# - SUPABASE_SERVICE_ROLE_KEY
#
# This file is for extra vendor secrets and local overrides used by Edge Functions.
# Add only the values needed for the flows you want to test locally.

# --- Local app / email branding ---
EMAIL_BRAND_NAME=Holzen Local
EMAIL_APP_URL=http://localhost:8080
# EMAIL_SUBJECT_PREFIX=[LOCAL]

# --- Stripe (test mode) ---
# Required for checkout, trial, portal, subscription sync, and related billing flows.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_FLEX_PACK_S=
STRIPE_PRICE_ID_FLEX_PACK_M=

# For local webhook testing:
# stripe listen --forward-to http://127.0.0.1:55421/functions/v1/stripe-webhook
# Then paste the printed whsec_... value into STRIPE_WEBHOOK_SECRET.

# --- Resend / auth email ---
# Required for auth-email-hook and transactional email flows.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SEND_EMAIL_HOOK_SECRET=
# EMAIL_FROM_DOMAIN=resend.dev
# EMAIL_FROM_LOCAL=onboarding
# EMAIL_NOTIFY_LOCAL=onboarding
# EMAIL_SENDER_DOMAIN=resend.dev

# --- AI providers ---
# Add the providers you want to exercise locally.
GOOGLE_AI_API_KEY=
# OPENROUTER_API_KEY=
# LLM_PROVIDER_ORDER=openrouter,google
# OPENROUTER_HTTP_REFERER=http://localhost:8080
# OPENROUTER_APP_TITLE=Holzen Local
# PERPLEXITY_API_KEY=

# --- Optional auth / ops / notifications ---
# Set CRON_SECRET if you want shipped local pg_cron HTTP jobs
# (check-volatility, pregenerate-companions, refresh-btc-prices)
# to call your local Edge Functions. `npm run supabase:start`
# / `npm run supabase:cron:local` will otherwise disable those jobs locally.
# CRON_SECRET=
# EMAIL_PREVIEW_SECRET=
# SLACK_WEBHOOK_URL=
# COINGECKO_API_KEY=
# CRYPTOCOMPARE_API_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- Optional observability ---
# SENTRY_DSN_EDGES=
SENTRY_ENVIRONMENT=local
# SENTRY_RELEASE=local-dev
# LOG_DRAIN_URL=
# LOG_DRAIN_TOKEN=
